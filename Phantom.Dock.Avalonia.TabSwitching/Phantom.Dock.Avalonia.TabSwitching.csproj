<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Separately releasable package: depends only on Avalonia + Dock.Avalonia, never on any
         Phantom.Workspaces assembly. -->
    <IsPackable>true</IsPackable>
    <PackageId>Phantom.Dock.Avalonia.TabSwitching</PackageId>
    <Description>Reusable numeric keyboard tab-switching (Alt+1..Alt+0) and on-tab number badges for arbitrary Avalonia.Dock docking areas.</Description>
    <Authors>Phantom</Authors>
    <PackageTags>avalonia;dock;tabs;keyboard;tab-switching</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Dock.Avalonia" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Phantom.Dock.Avalonia.TabSwitching.Tests" />
  </ItemGroup>
</Project>
